# ====================================
# Application Configuration
# ====================================

# Application settings
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# ====================================
# Database Configuration
# ====================================

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=status_monitor
DB_USER=thushima
DB_PASSWORD=your_secure_password

# R2DBC Configuration
SPRING_R2DBC_URL=r2dbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# JDBC Configuration (for Flyway)
SPRING_FLYWAY_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_FLYWAY_USER=${DB_USER}
SPRING_FLYWAY_PASSWORD=${DB_PASSWORD}
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_ENABLED=true

# ====================================
# JWT Configuration
# ====================================
JWT_SECRET=2a3814287a20f7f4fde6bcb2964c496df8e82be6e2482f4bd25fd51cf392330c
JWT_ACCESS_TOKEN_EXPIRATION=900000      # 15 minutes in milliseconds
JWT_REFRESH_TOKEN_EXPIRATION=2592000000 # 30 days in milliseconds

# ====================================
# Logging Configuration
# ====================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SPRING_WEB=INFO
LOGGING_LEVEL_SPRING_SECURITY=INFO
LOGGING_LEVEL_REACTOR_NETTY=WARN
LOGGING_LEVEL_HIBERNATE_SQL=DEBUG
LOGGING_LEVEL_HIBERNATE_TYPE=TRACE
LOGGING_LEVEL_SECURITY=DEBUG
LOGGING_LEVEL_FLYWAY=DEBUG

# ====================================
# Cache Configuration
# ====================================
CACHE_TTL=0  # No cache in production
CACHE_MAX_SIZE=10000

# ====================================
# Development Tools Configuration
# ====================================
DEVELOPMENT_TOOLS_LIVERELOAD_ENABLED=true
DEVELOPMENT_TOOLS_RESTART_ENABLED=true